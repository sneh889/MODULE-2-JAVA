import java.util.*;

abstract class Loan {
    protected double principal;
    protected double rate;
    protected double time;

    Loan(double principal, double rate, double time) {
        this.principal = principal;
        this.rate = rate;
        this.time = time;
    }

    abstract double calculateInterest();
}

class HomeLoan extends Loan {

    HomeLoan(double principal, double time) {
        super(principal, 8, time);
    }

    double calculateInterest() {
        return (principal * rate * time) / 100;
    }
}

class CarLoan extends Loan {

    CarLoan(double principal, double time) {
        super(principal, 10, time);
    }

    double calculateInterest() {
        return (principal * rate * time) / 100;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        while (sc.hasNextLine()) {
            String line = sc.nextLine();

            if (line.trim().isEmpty())
                continue;

            String[] data = line.split(",");

            double principal = Double.parseDouble(data[1]);
            double time = Double.parseDouble(data[2]);

            Loan loan;

            if (data[0].equalsIgnoreCase("Home")) {
                loan = new HomeLoan(principal, time);
                System.out.println("Home Loan Interest: " + loan.calculateInterest());
            } else {
                loan = new CarLoan(principal, time);
                System.out.println("Car Loan Interest: " + loan.calculateInterest());
            }
        }
    }
}
